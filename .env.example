# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mtgswapper
DB_HOST=db                    # docker-compose service name (or 'localhost' for local PostgreSQL)
DB_PORT=5432

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# API Configuration
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Scryfall API 
SCRYFALL_API_URL=https://api.scryfall.com

# TensorFlow Card Image Scanning (optional, for card image recognition)
# Local ML model for identifying MTG cards from phone camera images
USE_IMAGE_SCANNING=False
TENSORFLOW_MODEL_PATH=./models/mtg_card_detector.tflite

# Email Configuration (optional, for invites/notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
