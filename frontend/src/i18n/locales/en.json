  "about": {
    "title": "About MTG Swapper",
    "intro": "MTG Swapper is a community-driven platform for Magic: The Gathering players to swap cards directly with each other. Whether you're trading a single card or an entire deck, we make it easy to find new homes for your cards and discover ones you need.",
    "section1Title": "Getting Started: Upload Your Collection",
    "section1Intro": "Start by building your card collection in three simple ways:",
    "section1Step1": "Add cards one by one using the Scryfall search autocomplete",
    "section1Step2": "Bulk import from Moxfield or MTG Arena using plain-text format (one card per line, e.g. '4 Black Lotus')",
    "section1Step3": "Scan real cards with your phone camera (experimental feature — requires good lighting)",
    "section2Title": "Finding Cards: Search & Browse",
    "section2Intro": "Once your collection is ready, start exploring what other players have available:",
    "section2Step1": "Use the Search tab to find any card by name — results show all players who have it",
    "section2Step2": "Click on a player to view their complete available collection",
    "section2Step3": "See player reputation (average rating and total completed swaps) to build trust",
    "section3Title": "Making an Offer: The Swap Process",
    "section3Intro": "When you find cards you want, initiate a swap with this flow:",
    "section3Step1": "Select cards you want to offer and cards you want in return — create and send your offer",
    "section3Step2": "The other player can accept, decline, or make a counteroffer (max 4 rounds of negotiation)",
    "section3Step3": "Once accepted, coordinate how you'll exchange: in-person meetup or arrange details in the message thread",
    "section3Step4": "After swapping, both players mark complete and rate each other 1-5 stars to build community trust",
    "section4Title": "Current Limitations",
    "section4Intro": "Please note these constraints in our closed beta:",
    "section4Point1": "Invite-only access — you received an invite code from a friend to join",
    "section4Point2": "In-person swaps only right now (mail swaps coming soon) — coordinate location and time in the message thread",
    "section4Point3": "Closed beta features limited to English and French UI languages for now",
    "homeLink": "← Back to my collection"
  }
