# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.pyc

# Virtual environment — never copy the venv into the image,
# the Dockerfile installs fresh from requirements.txt
venv/
env/
.venv/

# Local dev database (SQLite) — production uses Neon PostgreSQL
db.sqlite3

# Environment files — secrets must never end up in the image
.env
.env.*

# Collected static files — regenerated by collectstatic during build
staticfiles/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
